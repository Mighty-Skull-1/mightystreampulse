# Twitch Bot Configuration
# 1. BOT_USERNAME: Your Twitch account name or secondary bot account username (lowercase)
BOT_USERNAME=your_bot_username

# 2. OAUTH_TOKEN: Twitch OAuth token. Generate one easily from: https://twitchapps.com/tmi/
# Format should be: oauth:xxxxxxxxxxxxxxxxx
OAUTH_TOKEN=oauth:your_oauth_token_here

# 3. CHANNEL: The Twitch channel you want the bot to join and send messages to (lowercase)
CHANNEL=your_channel_name

# Web Dashboard Port
PORT=3000
